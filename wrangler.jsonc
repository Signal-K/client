{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starsailors-client",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "starsailors.space", "custom_domain": true },
    { "pattern": "www.starsailors.space", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
