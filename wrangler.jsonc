{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starsailors-client",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "starsailors.space", "custom_domain": true },
    { "pattern": "www.starsailors.space", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_65umDftbbTkrm1V6azue6OeU4u5c8iJcaHm4JtJ95di",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.posthog.com",
    "posthog_api_key": "phc_65umDftbbTkrm1V6azue6OeU4u5c8iJcaHm4JtJ95di",
    "posthog_project_id": "199773",
    "posthog_region": "US Cloud"
  },
  "observability": {
    "enabled": true
  },
  // OpenNext SSR cannot finish within the Workers Free 10ms CPU cap
  // (Cloudflare Error 1102 / exceededCpu on starsailors.space, 2026-09-18).
  // Requires Workers Paid. 60s covers cold start + Clerk + a few PocketBase
  // round-trips without taking the 5-minute maximum.
  "limits": {
    "cpu_ms": 60000
  },
  // `wrangler deploy --env staging` — a constant preview target. Runtime
  // secrets (POCKETBASE_URL, CLERK_SECRET_KEY, ...) are synced from the same
  // repo secrets as production on purpose — this shares the one ecosystem
  // PocketBase/Clerk instance rather than standing up a second paid backend,
  // so accounts/data are never split from prod.
  //
  // Custom domain is staging.starsailors.space, NOT the *.workers.dev
  // subdomain: production's Clerk instance uses a custom Frontend API proxy
  // domain (clerk.starsailors.space) that rejects any request whose Origin
  // isn't starsailors.space or a subdomain of it ("Invalid HTTP Origin
  // header" / origin_invalid) — a workers.dev origin can load the app but
  // can never sign in. staging.starsailors.space satisfies that check while
  // still using the exact same shared Clerk/PocketBase instance.
  "env": {
    "staging": {
      "name": "starsailors-client-staging",
      "main": ".open-next/worker.js",
      "compatibility_date": "2026-07-24",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": true,
      // Explicit override — without this, wrangler inherits the top-level
      // `routes` and reassigns the production custom domains
      // (starsailors.space, www.starsailors.space) to this Worker on deploy.
      "routes": [{ "pattern": "staging.starsailors.space", "custom_domain": true }],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_POSTHOG_KEY": "phc_65umDftbbTkrm1V6azue6OeU4u5c8iJcaHm4JtJ95di",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.posthog.com",
        "posthog_api_key": "phc_65umDftbbTkrm1V6azue6OeU4u5c8iJcaHm4JtJ95di",
        "posthog_project_id": "199773",
        "posthog_region": "US Cloud"
      },
      "observability": {
        "enabled": true
      },
      "limits": {
        "cpu_ms": 60000
      }
    }
  }
}
