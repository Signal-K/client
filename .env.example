# Legacy PostgreSQL configuration (only needed for one-off migration scripts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navigation"
POSTGRES_DB=navigation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secret

# Next.js Configuration
NODE_ENV=development

# Legacy Supabase configuration (only needed for one-off migration scripts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clerk Configuration (replacing Supabase Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/game
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/game
# Signing secret for the /api/webhooks/clerk endpoint (Clerk dashboard > Webhooks > your endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=

# Pocketbase Configuration (replacing Supabase Postgres + Storage, see .claude/plans/sparkling-cooking-dewdrop.md Phase 2)
# Local: http://localhost:8095; production Compose: http://pocketbase:8090
POCKETBASE_URL=http://localhost:8095
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001

# PostHog (Vercel env vars)
posthog_api_key=
posthog_project_id=
posthog_region=US Cloud
