# Next.js Configuration
NODE_ENV=development

# Clerk Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/game
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/game
# Signing secret for the /api/webhooks/clerk endpoint (Clerk dashboard > Webhooks > your endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=

# Pocketbase Configuration
# Local: http://localhost:8095; production Compose: http://pocketbase:8090
POCKETBASE_URL=http://localhost:8095
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001

# PostHog (Vercel env vars)
posthog_api_key=
posthog_project_id=
posthog_region=US Cloud
